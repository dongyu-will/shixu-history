  "cues": [
    {
      "eventId": "prc-m-1",
      "start": 0,
      "end": 6.43,
      "text": "一九五零年六月，七届三中全会确定，争取三年左右国家财经状况基本好转。"
    },
    {
      "eventId": "prc-m-1",
      "start": 6.43,
      "end": 12.2,
      "text": "会议提出不要四面出击的策略，集中力量巩固新生政权。"
    },
    {
      "eventId": "prc-l-1",
      "start": 12.2,
      "end": 18.95,
      "text": "同年，新中国颁布土地改革法，由征收富农多余土地，改为保存富农经济。"
    },
    {
      "eventId": "prc-l-1",
      "start": 18.95,
      "end": 25.7,
      "text": "废除封建剥削土地所有制，实行农民土地所有制，为工业化开辟道路。"
    },
    {
      "eventId": "prc-e-1",
      "start": 25.7,
      "end": 30.91,
      "text": "美军把战火烧到鸭绿江边，志愿军毅然跨江抗美援朝、保家卫国。"
    },
    {
      "eventId": "prc-e-1",
      "start": 30.91,
      "end": 42.3,
      "text": "一九五三年停战协定签字，打破美军不可战胜的神话，为建设赢得和平环境。"
    },
    {
      "eventId": "prc-e-2",
      "start": 42.3,
      "end": 49.84750566893424,
      "text": "国民经济恢复后，一九五三年提出过渡时期总路线，一化为主体，三改为两翼。"
    },
    {
      "eventId": "prc-e-2",
      "start": 49.84750566893424,
      "end": 55.8,
      "text": "同步实施一五计划，优先发展重工业，统筹推进工业化与社会主义改造。"
    },
    {
      "eventId": "prc-e-3",
      "start": 55.8,
      "end": 61.75,
      "text": "一九五四年，第一届全国人大召开，制定第一部社会主义类型宪法。"
    },
    {
      "eventId": "prc-e-3",
      "start": 61.75,
      "end": 69.3,
      "text": "人民代表大会制度正式确立，新中国基本政治制度全面奠基。"
    },
    {
      "eventId": "prc-l-2",
      "start": 69.3,
      "end": 74.99002267573697,
      "text": "农业与手工业改造遵循自愿互利原则，依托合作社经济稳步过渡。"
    },
    {
      "eventId": "prc-l-2",
      "start": 74.99002267573697,
      "end": 81.5,
      "text": "从互助组、初级社发展到高级社，逐步实现社会主义集体所有制。"
    },
    {
      "eventId": "prc-e-4",
      "start": 81.5,
      "end": 86.81002267573696,
      "text": "对资本主义工商业，采取利用、限制、改造与和平赎买政策。"
    },
    {
      "eventId": "prc-e-4",
      "start": 86.81002267573696,
      "end": 95,
      "text": "从初级国家资本主义到全行业公私合营，和平完成所有制变革。"
    },
    {
      "eventId": "prc-e-5",
      "start": 95,
      "end": 101.21,
      "text": "一九五六年底，三大改造基本完成，社会主义基本经济制度正式建立。"
    },
    {
      "eventId": "prc-e-5",
      "start": 101.21,
      "end": 111.6,
      "text": "社会主义基本制度全面确立，中国由此迈入社会主义初级阶段。"
    },
    {
      "eventId": "prc-w-1",
      "start": 111.6,
      "end": 118.13,
      "text": "一九五六年四月，毛泽东发表论十大关系报告，提出以苏为鉴，开启第二次结合。"
    },
    {
      "eventId": "prc-w-1",
      "start": 118.13,
      "end": 126.2,
      "text": "确立调动一切积极因素的方针，成为探索中国建设道路的良好开端。"
    },
    {
      "eventId": "prc-m-2",
      "start": 126.2,
      "end": 132.47,
      "text": "同年秋，中共八大正确分析国内主要矛盾，坚持在综合平衡中稳步前进。"
    },
    {
      "eventId": "prc-m-2",
      "start": 132.47,
      "end": 139.7,
      "text": "陈云提出三个主体、三个补充，明确集中力量发展社会生产力。"
    },
    {
      "eventId": "prc-w-2",
      "start": 139.7,
      "end": 146.91,
      "text": "一九五七年，毛泽东论述正确处理人民内部矛盾，指出社会主义基本矛盾是非对抗性的。"
    },
    {
      "eventId": "prc-w-2",
      "start": 146.91,
      "end": 154.3,
      "text": "严格区分两类不同性质矛盾，把处理人民内部矛盾作为政治生活主题。"
    },
    {
      "eventId": "prc-m-3",
      "start": 154.3,
      "end": 160.81038548752835,
      "text": "一九五八年八大二次会议后，因急于求成，发动大跃进与人民公社化运动。"
    },
    {
      "eventId": "prc-m-3",
      "start": 160.81038548752835,
      "end": 166.5,
      "text": "违背客观经济规律的曲折探索，给社会主义建设留下深刻教训。"
    },
    {
      "eventId": "prc-m-4",
      "start": 166.5,
      "end": 174.51,
      "text": "面对经济困难，一九六一年八届九中全会，决定实行调整、巩固、充实、提高方针。"
    },
    {
      "eventId": "prc-m-4",
      "start": 174.51,
      "end": 178.7,
      "text": "国民经济由此转入全面调整，逐步恢复生机。"
    },
    {
      "eventId": "prc-m-5",
      "start": 178.7,
      "end": 187.9,
      "text": "一九六四年三届人大一次会议上，周恩来正式提出建设四个现代化的宏伟目标。"
    },
    {
      "eventId": "prc-e-6",
      "start": 187.9,
      "end": 194.65,
      "text": "艰辛探索时期，我国顶住封锁，建成独立的、比较完整的工业和国民经济体系。"
    },
    {
      "eventId": "prc-e-6",
      "start": 194.65,
      "end": 204.5,
      "text": "大庆油田投产，原子弹、氢弹与东方红一号卫星接连成功，筑牢大国基石。"
    },
    {
      "eventId": "prc-e-7",
      "start": 204.5,
      "end": 209.77002267573695,
      "text": "一九七一年，联大通过二七五八号决议，恢复中国在联合国一切合法权利。"
    },
    {
      "eventId": "prc-e-7",
      "start": 209.77002267573695,
      "end": 219.1,
      "text": "随后中美关系走向正常化、中日建交，新中国国际地位显著提升。"
    },
    {
      "eventId": "prc-e-8",
      "start": 219.1,
      "end": 225.17,
      "text": "一九七八年五月，真理标准问题大讨论展开，冲破两个凡是的思想禁锢。"
    },
    {
      "eventId": "prc-e-8",
      "start": 225.17,
      "end": 231.3,
      "text": "实践是检验真理的唯一标准，成为拨乱反正与改革开放的思想先导。"
    },
    {
      "eventId": "prc-m-6",
      "start": 231.3,
      "end": 238.25,
      "text": "一九七八年十二月，十一届三中全会重新确立思想、政治、组织三条正确路线。"
    },
    {
      "eventId": "prc-m-6",
      "start": 238.25,
      "end": 247.9,
      "text": "把工作重点转移到经济建设、实行改革开放，实现建国以来深远意义的伟大转折。"
    },
    {
      "eventId": "prc-l-3",
      "start": 247.9,
      "end": 254.80562358276643,
      "text": "改革率先在农村破冰。安徽凤阳小岗村实行大包干，打破人民公社体制弊端。"
    },
    {
      "eventId": "prc-l-3",
      "start": 254.80562358276643,
      "end": 262.5,
      "text": "家庭联产承包责任制，实现集体所有权与家庭经营权分离，极大解放农村生产力。"
    },
    {
      "eventId": "prc-m-7",
      "start": 262.5,
      "end": 268.89,
      "text": "一九七九年理论工作务虚会上，邓小平首次明确提出四项基本原则。"
    },
    {
      "eventId": "prc-m-7",
      "start": 268.89,
      "end": 274.7,
      "text": "为改革开放和现代化建设，确立了不可动摇的立国之本。"
    },
    {
      "eventId": "prc-e-9",
      "start": 274.7,
      "end": 282.71,
      "text": "一九八零年，深圳、珠海、汕头、厦门四大经济特区设立，对外开放破局起步。"
    },
    {
      "eventId": "prc-e-9",
      "start": 282.71,
      "end": 291.3,
      "text": "随后开放十四个沿海城市、设立海南特区、开发上海浦东，形成点线面开放格局。"
    },
    {
      "eventId": "prc-m-8",
      "start": 291.3,
      "end": 297.69,
      "text": "一九八一年，十一届六中全会通过第二个历史决议，彻底否定文化大革命。"
    },
    {
      "eventId": "prc-m-8",
      "start": 297.69,
      "end": 304.8,
      "text": "科学评价毛泽东与毛泽东思想，概括活的灵魂，完成指导思想拨乱反正。"
    },
    {
      "eventId": "prc-m-9",
      "start": 304.8,
      "end": 314,
      "text": "一九八二年中共十二大，邓小平提出走自己的道路，建设有中国特色的社会主义。"
    },
    {
      "eventId": "prc-m-10",
      "start": 314,
      "end": 322.01,
      "text": "一九八七年中共十三大，系统阐述社会主义初级阶段理论，和一个中心、两个基本点。"
    },
    {
      "eventId": "prc-m-10",
      "start": 322.01,
      "end": 326.2,
      "text": "同时制定了现代化建设三步走发展战略。"
    },
    {
      "eventId": "prc-w-3",
      "start": 326.2,
      "end": 333.394693877551,
      "text": "一九九二年初，邓小平视察武昌、深圳、珠海与上海，发表南方谈话。"
    },
    {
      "eventId": "prc-w-3",
      "start": 333.394693877551,
      "end": 339.7,
      "text": "阐明计划和市场都是经济手段、改革也是解放生产力，掀起新一轮思想解放。"
    },
    {
      "eventId": "prc-m-11",
      "start": 339.7,
      "end": 345.390022675737,
      "text": "同年秋，中共十四大正式确立，建立社会主义市场经济体制的改革目标。"
    },
    {
      "eventId": "prc-m-11",
      "start": 345.390022675737,
      "end": 353.2,
      "text": "明确国有企业改革，是建立市场经济体制的中心环节。"
    },
    {
      "eventId": "prc-m-12",
      "start": 353.2,
      "end": 360.34022675736963,
      "text": "一九九七年中共十五大，把邓小平理论写入党章，明确初级阶段基本经济制度。"
    },
    {
      "eventId": "prc-m-12",
      "start": 360.34022675736963,
      "end": 365.4,
      "text": "香港与澳门相继回归祖国，一国两制构想取得历史性成功。"
    },
    {
      "eventId": "prc-e-10",
      "start": 365.4,
      "end": 374.6,
      "text": "二零零一年十二月，中国正式加入世界贸易组织，对外开放迈入全方位新阶段。"
    },
    {
      "eventId": "prc-m-13",
      "start": 374.6,
      "end": 383.8,
      "text": "二零零二年中共十六大，确立三个代表重要思想，提出全面建设小康社会目标。"
    },
    {
      "eventId": "prc-m-14",
      "start": 383.8,
      "end": 393,
      "text": "二零零七年中共十七大，深入阐述科学发展观，概括中国特色社会主义理论体系。"
    },
    {
      "eventId": "prc-m-15",
      "start": 393,
      "end": 399.61,
      "text": "二零一二年中共十八大，明确五位一体总体布局，和两个一百年奋斗目标。"
    },
    {
      "eventId": "prc-m-15",
      "start": 399.61,
      "end": 405.2,
      "text": "中国特色社会主义由此进入新时代。"
    },
    {
      "eventId": "prc-m-16",
      "start": 405.2,
      "end": 413.63,
      "text": "二零一三年十八届三中全会部署全面深化改革，推进治理体系和治理能力现代化。"
    },
    {
      "eventId": "prc-m-16",
      "start": 413.63,
      "end": 419.8,
      "text": "推动改革由局部探索，迈向系统集成、全面深化的新阶段。"
    },
    {
      "eventId": "prc-m-17",
      "start": 419.8,
      "end": 426.15,
      "text": "二零一七年中共十九大，确立习近平新时代中国特色社会主义思想的历史地位。"
    },
    {
      "eventId": "prc-m-17",
      "start": 426.15,
      "end": 434.4,
      "text": "作出社会主要矛盾新转化论断，部署两步走现代化强国战略。"
    },
    {
      "eventId": "prc-l-4",
      "start": 434.4,
      "end": 441.23,
      "text": "农村推行土地三权分置制度创新，并打赢脱贫攻坚战、历史性消除绝对贫困。"
    },
    {
      "eventId": "prc-l-4",
      "start": 441.23,
      "end": 448.9,
      "text": "二零二一年如期全面建成小康社会，实现第一个百年奋斗目标。"
    },
    {
      "eventId": "prc-m-18",
      "start": 448.9,
      "end": 455.99,
      "text": "二零二一年，十九届六中全会通过第三个历史决议，阐明两个确立的决定性意义。"
    },
    {
      "eventId": "prc-m-18",
      "start": 455.99,
      "end": 463.4,
      "text": "系统总结党百年奋斗的五大历史意义，与十个坚持宝贵经验。"
    },
    {
      "eventId": "prc-m-19",
      "start": 463.4,
      "end": 471.23,
      "text": "二零二二年中共二十大，明确以中国式现代化，全面推进中华民族伟大复兴。"
    },
    {
      "eventId": "prc-m-19",
      "start": 471.23,
      "end": 480,
      "text": "阐明五个中国特色与党的自我革命，引领迈向第二个百年奋斗目标新征程。"
    }
  ],
