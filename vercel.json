{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd timeline && npm ci",
  "buildCommand": "cd timeline && npm run build",
  "outputDirectory": "timeline/dist/client",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/timeline-(.*)\\.(m4a|vtt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/road-90.m4a",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
